# 项目与服务商配置（多项目，每项目可配多个服务商）
# YAML 格式，文件根即项目数组。
#
# 用法：
#   ops-console --project <name> snapshot --keep 2
#   不传 --project 时遍历全部项目
#
# 凭据推荐通过环境变量注入（CI / systemd / cron 场景），不写进文件：
#   export ALIYUN_ACCESS_KEY_ID=xxxx
#   export ALIYUN_ACCESS_KEY_SECRET=xxxx
#
# 阿里云 RAM 子账号最小权限策略（SWAS 快照轮转）：
# 注意：RAM Action 前缀是 swas-open:（不是 swas:），见官方 API 文档"授权信息"。
# {
#   "Version": "1",
#   "Statement": [
#     {
#       "Effect": "Allow",
#       "Action": [
#         "swas-open:ListInstances",
#         "swas-open:ListDisks",
#         "swas-open:ListSnapshots",
#         "swas-open:CreateSnapshot",
#         "swas-open:DeleteSnapshot"
#       ],
#       "Resource": "*"
#     }
#   ]
# }

- name: demo
  description: 示例项目：阿里云深圳轻量服务器快照轮转
  # 每行一个服务商：key 即 kind（如 aliyun / tencent / aws ...），值即该服务商配置
  providers:
    aliyun:
      region: cn-shenzhen
      access_key_id: ""
      access_key_secret: ""

# 第二个项目示例：同账号多区域 / 多项目隔离
# - name: prod
#   description: 生产环境
