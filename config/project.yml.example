# 项目与服务商配置（多项目，每项目可配多个服务商）
# YAML 格式，文件根即项目数组。
#
# 用法：
#   ops-console --project <name> snapshot --keep 2
#   不传 --project 时遍历全部项目
#
# 凭据推荐通过环境变量注入（CI / systemd / cron 场景），不写进文件：
#   export ALIYUN_ACCESS_KEY_ID=xxxx
#   export ALIYUN_ACCESS_KEY_SECRET=xxxx
#
# region 支持两种模式：
#   - 留空 / global：自动发现账号下全部地域（SWAS ListRegions ∪ ECS DescribeRegions），
#     跨地域汇总巡检。适合"一个项目 = 一个阿里云运维账号"的全量运维。
#   - 具体地域（如 cn-shenzhen）：固定单地域。
#
# 阿里云 RAM 子账号最小权限策略（SWAS 快照轮转 + ECS 只读检查 + 地域发现）：
# 注意：SWAS 的 Action 前缀是 swas-open:（不是 swas:），见官方 API 文档"授权信息"。
# global 模式额外需要 ListRegions / DescribeRegions（用于自动发现地域）。
# {
#   "Version": "1",
#   "Statement": [
#     {
#       "Effect": "Allow",
#       "Action": [
#         "swas-open:ListInstances",
#         "swas-open:ListDisks",
#         "swas-open:ListSnapshots",
#         "swas-open:CreateSnapshot",
#         "swas-open:DeleteSnapshot",
#         "swas-open:ListRegions",
#         "ecs:DescribeInstances",
#         "ecs:DescribeDisks",
#         "ecs:DescribeAutoSnapshotPolicyEx",
#         "ecs:DescribeRegions",
#         "domain:QueryCommonInfo",      # expiry-domain 域名到期提醒用
#         "resourcecenter:SearchResources" # global 目录加速（可选，不加则遍历全部地域）
#       ],
#       "Resource": "*"
#     }
#   ]
# }

- name: demo
  description: 示例项目：阿里云全部地域自动巡检（region 留空 = 自动发现）
  # 每行一个服务商：key 即 kind（如 aliyun / tencent / aws ...），值即该服务商配置
  providers:
    aliyun:
      # 留空或不写 = global（自动发现账号下全部地域）；固定单地域则填如 cn-shenzhen
      region: global
      access_key_id: ""
      access_key_secret: ""

# 第二个项目示例：固定单地域
